# Environment variables for a deployed (non-Development) API. Never commit real values.
# ASP.NET Core maps "__" to ":" (GoogleMaps__ApiKey -> GoogleMaps:ApiKey).
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=<connection-string>
GoogleMaps__ApiKey=<your-restricted-browser-key>
GoogleMaps__MapId=<map-id-or-DEMO_MAP_ID>
# Exact dashboard origin(s), comma-free indexed form:
Cors__Origins__0=https://<your-dashboard-host>
# Leave unset to keep /api/admin/* disabled (403). Set only if imports must run in this environment:
# Admin__ApiKey=<long-random-value>
